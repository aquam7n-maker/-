# استفاده از ماژول array برای آرایه عددی
import array

# ایجاد آرایه از نوع عدد صحیح
arr = array.array('i', [1, 2, 3, 4])
arr.append(5)     # افزودن عنصر
arr[1] = 10       # تغییر مقدار عنصر دوم
print(arr)        # خروجی: array('i', [1, 10, 3, 4, 5])

