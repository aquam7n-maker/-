# تبدیل ورودی به عدد و محاسبه جذر
import math

x = input("Enter a number: ")
y = math.sqrt(float(x))
print(f"The square root of {x} is {y}")

# اعتبارسنجی ورودی با try/except
y = True
while y:
    x = input("Enter a number: ")
    try:
        x = float(x)
        y = False
    except:
        print("Wrong input, please try again.")

print("Thank you!")

# استفاده از try/except ساده
try:
    print(x)
except:
    print("An exception occurred")

# استفاده از except خاص و عمومی
try:
    print(x)
except NameError:
    print("Variable x is not defined")
except:
    print("Something else went wrong")

# استفاده از else در try/except
try:
    print("Hello")
except:
    print("Something went wrong")
else:
    print("Nothing went wrong")

# استفاده از finally
try:
    print(x)
except:
    print("Something went wrong")
finally:
    print("The 'try except' is finished")

# توابع ریاضی داخلی
x = min(5, 10, 25)
y = max(5, 10, 25)
print(x)  # خروجی: 5
print(y)  # خروجی: 25

x = abs(-7.25)
print(x)  # خروجی: 7.25

x = pow(4, 3)
print(x)  # خروجی: 64

# استفاده از ماژول math
import math

x = math.sqrt(64)
print(x)  # خروجی: 8.0

x = math.ceil(1.4)
y = math.floor(1.4)
print(x)  # خروجی: 2
print(y)  # خروجی: 1